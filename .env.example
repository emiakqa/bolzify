# Supabase — hole diese Werte aus deinem Supabase-Projekt:
# Project Settings → API → Project URL + anon/public key
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# api-football.com — API-Key holst du auf api-football.com/pricing
# (noch nicht nötig für Tag 1, kommt in Woche 1 Tag 4)
# API_FOOTBALL_KEY=

# Sentry — Crash-Reporting. Optional: ohne DSN bleibt Sentry deaktiviert.
# Holen: sentry.io → Project Settings → Client Keys (DSN) → DSN kopieren.
# Wichtig: Native Code → wirkt nur in Dev-Build/TestFlight, nicht in Expo Go.
# EXPO_PUBLIC_SENTRY_DSN=https://xxxxxxxx@oXXXXXX.ingest.sentry.io/XXXXXXX

# Sentry Auth Token — NUR für Source-Maps-Upload während EAS-Build.
# Holen: sentry.io → Settings → Account → API → Auth Tokens.
# Scopes: project:releases, project:write, org:read.
# Lokal selten gebraucht. In EAS via `eas secret:create` ablegen, NICHT hier.
# SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
